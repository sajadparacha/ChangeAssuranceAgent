# OpenAI / ChatGPT — never commit real keys
OPENAI_API_KEY=sk-your-key-here

# AI mode:
#   spring-ai | openai | chatgpt  → ChatGPT (cloud)
#   ollama | local                → local OpenAI-compatible server (recommended: Ollama + Qwen3)
#   fake | disabled
CHANGEASSURANCE_AI_MODE=spring-ai
CHANGEASSURANCE_AI_SPRING_AI_ENABLED=true

# Model id — leave blank for mode defaults (gpt-4o-mini cloud, qwen3:14b local)
# Examples: gpt-4o-mini, gpt-4o, qwen3:14b, qwen3:8b
CHANGEASSURANCE_AI_MODEL=gpt-4o-mini

# Optional comma-separated allowlist (blank = any valid model; UI shows discovered + suggestions)
# CHANGEASSURANCE_AI_ALLOWED_MODELS=qwen3:14b,qwen3:8b,gpt-4o-mini

# Offer Ollama as a selectable provider in the UI (alongside ChatGPT when cloud mode)
CHANGEASSURANCE_AI_OLLAMA_ENABLED=true
CHANGEASSURANCE_AI_OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Local Ollama + Qwen3 (recommended offline setup) ---
# 1) ollama pull qwen3:14b
# 2) uncomment below (API key can be any non-blank placeholder for local servers)
# CHANGEASSURANCE_AI_MODE=ollama
# CHANGEASSURANCE_AI_MODEL=qwen3:14b
# CHANGEASSURANCE_AI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# Or keep CHANGEASSURANCE_AI_MODE=spring-ai and pick "Ollama (local)" + a model in the UI
# (requires Ollama running; discovered models appear in the model dropdown)

# --- LM Studio alternative ---
# CHANGEASSURANCE_AI_MODE=local
# CHANGEASSURANCE_AI_BASE_URL=http://localhost:1234/v1
# CHANGEASSURANCE_AI_MODEL=<model-id-shown-in-lm-studio>
# OPENAI_API_KEY=lm-studio

# --- Database catalog metadata (package impact) ---
# Default is live Oracle. Fake catalog is for unit tests / offline only.
CHANGEASSURANCE_DB_METADATA_MODE=oracle
CHANGEASSURANCE_DB_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
CHANGEASSURANCE_DB_USERNAME=APP
CHANGEASSURANCE_DB_PASSWORD=AppDemoPass1
CHANGEASSURANCE_DB_DRIVER=oracle.jdbc.OracleDriver
CHANGEASSURANCE_DB_DEFAULT_OWNER=APP
# Offline override (not recommended for package-impact demos):
# CHANGEASSURANCE_DB_METADATA_MODE=fake
# ALLOW_FAKE_CATALOG=1

# Bounded investigation follow-ups (package impact)
# CHANGEASSURANCE_INVESTIGATION_MAX_FOLLOW_UPS=2
# CHANGEASSURANCE_INVESTIGATION_LARGE_DEPENDENTS=4
# CHANGEASSURANCE_INVESTIGATION_TRANSITIVE_DEPTH=3
# CHANGEASSURANCE_INVESTIGATION_TRANSITIVE_NODES=50
# CHANGEASSURANCE_INVESTIGATION_SOURCE_MAX_ROWS=100
